$ bash -c $'pm_tests () \n{ \n    local line th t out count=0;\n    [[ -f "$1" && -r "$1" ]] || { \n        echo \'proof-map missing/unreadable\';\n        return 1\n    };\n    while IFS= read -r line || [ -n "$line" ]; do\n        [[ "$line" = \\#* || ! "$line" =~ [^[:space:]] ]] && continue;\n        [[ "$line" = *\'\t\'* ]] || { \n            echo "proof-map malformed row: $line";\n            return 1\n        };\n        th="${line%%\t*}";\n        t="${line#*\t}";\n        [[ "$th" =~ [^[:space:]] && "$t" =~ [^[:space:]] && "$t" != *\'\t\'* ]] || { \n            echo "proof-map malformed row: $line";\n            return 1\n        };\n        count=$((count + 1));\n        if ! out=$(cargo test --locked --lib -- --exact "$t" 2>&1); then\n            echo "rust test missing/failed: $t";\n            printf \'%s\\n\' "$out";\n            return 1;\n        fi;\n        grep -Eq \'^test result: ok\\. 1 passed; 0 failed;\' <<< "$out" || { \n            echo "rust test missing/failed: $t";\n            printf \'%s\\n\' "$out";\n            return 1\n        };\n        echo "ok $th -> $t";\n    done < "$1";\n    [ "$count" -gt 0 ] || { \n        echo "proof-map has no test rows";\n        return 1\n    }\n}; pm_tests \'/sessions/rcw-01p47zwxfqmkyjbfvzkscr5d/tmp/rust-cicd-core.BIRDF3/canaries/maps/comments.tsv\''
