$ bash -c $'lean_text () \n{ \n    local files file code count=0;\n    files="$(find "$1" -type d -name .lake -prune -o -type f -name \'*.lean\' -print)" || { \n        echo "LEAN source discovery failed";\n        return 1\n    };\n    [ -n "$files" ] || { \n        echo "LEAN sources missing";\n        return 1\n    };\n    while IFS= read -r file; do\n        count=$((count + 1));\n        if grep -nE \'\\b(sorry|admit)\\b\' "$file"; then\n            echo "LEAN forbidden proof text: $file";\n            return 1;\n        else\n            code=$?;\n            [ "$code" -eq 1 ] || { \n                echo "LEAN source scan failed: $file";\n                return 1\n            };\n        fi;\n    done <<< "$files";\n    [ "$count" -gt 0 ]\n}; lean_text \'/sessions/rcw-01p47zwxfqmkyjbfvzkscr5d/tmp/rust-cicd-core.AabxvY/lean\''
