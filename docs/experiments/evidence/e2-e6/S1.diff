diff --git a/src/date.rs b/src/date.rs
index 5d34c22..d17340b 100644
--- a/src/date.rs
+++ b/src/date.rs
@@ -257,6 +257,11 @@ pub fn format_rfc3339_seconds(system_time: SystemTime) -> Rfc3339Timestamp {
     Rfc3339Timestamp(system_time, Precision::Seconds)
 }
 
+/// Same as [`format_rfc3339_seconds`]: an RFC3339 timestamp without fractional seconds.
+pub fn format_rfc3339_secs_only(system_time: SystemTime) -> Rfc3339Timestamp {
+    format_rfc3339_seconds(system_time)
+}
+
 /// Format an RFC3339 timestamp `2018-02-14T00:28:07.000Z`
 ///
 /// This format always shows milliseconds even if millisecond value is zero.
