index 7e6da5c..b83a813 100644
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -25,7 +25,7 @@ mod wrapper;
 pub use self::date::Rfc3339Timestamp;
 pub use self::date::{
     format_rfc3339, format_rfc3339_micros, format_rfc3339_millis, format_rfc3339_nanos,
-    format_rfc3339_seconds,
+    format_rfc3339_seconds, format_rfc3339_secs_only,
 };
 pub use self::date::{parse_rfc3339, parse_rfc3339_weak, Error as TimestampError};
 pub use self::duration::{format_duration, FormattedDuration};
diff --git a/tests/behavior.rs b/tests/behavior.rs
index a0e7883..f32ec77 100644
--- a/tests/behavior.rs
+++ b/tests/behavior.rs
@@ -193,3 +193,12 @@ fn timestamp_wrapper() {
     let parsed = Timestamp::from_str("2018-02-13 23:08:32").unwrap();
     assert_eq!(SystemTime::from(parsed), t);
 }
+
+#[test]
+fn secs_only_equals_seconds() {
+    let t = at(1_518_563_312, 123_456_789);
+    assert_eq!(
+        humantime::format_rfc3339_secs_only(t).to_string(),
+        "2018-02-13T23:08:32Z"
+    );
+}
