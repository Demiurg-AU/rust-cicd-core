# Pilot: chronotope/humantime (criterion 3, ROADMAP). Configuration only - read by scripts/pilot.sh.
CRATE_NAME=humantime
# 997ff566 (upstream 2.4.0) plus the pilot's fixes for S1d, S1e and S2a, on the unrelated-history branch
# pilot/humantime-fixes of this repository (crate code only; no template file there)
CRATE_URL=https://github.com/Demiurg-AU/rust-cicd-core
CRATE_SHA=527edafe46ce0818135b25ce16b4af91e037e312
# profile: the crate has no Lean project; the template's Lean stage is skipped visibly (CL29-CL32 still run)
REQUIRE_LEAN=0
# stage 3b: every item is required; a missing manifest or result is a FAIL with its reason (scripts/pilot-verdict.sh)
PILOT_3B_REQUIRE="fuzz-targets fuzz-canaries k5 k4 claims"
PILOT_3B_CLAIMS="H1 H2 H3"
# Kani: reported on its own line; ABSTAIN without a finished proof; does not decide 3b (set "required" to make it)
PILOT_KANI=abstain
